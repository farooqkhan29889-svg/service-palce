# Application
APP_NAME=ServeNow API
DEBUG=True
API_VERSION=1.0.0

# Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=servenow

# Security - generate a strong random value for production
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Razorpay - leave blank to use demo mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Platform settings
PLATFORM_COMMISSION_RATE=0.10
GST_RATE=0.18

# Firebase - path to service account JSON (push notifications)
FIREBASE_CREDENTIALS_PATH=

# Redis - caching and real-time fan-out
REDIS_URL=redis://localhost:6379
